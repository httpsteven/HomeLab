# ---------------------------------------------------------------------------
# Home Lab Dashboard — service connections
#
# Copy to `.env.local` and fill in what you have. Every service is optional:
# the dashboard shows a neutral "not connected" tile for anything missing and
# keeps working, so you can wire these up one at a time.
#
# ADDRESSES: if the dashboard runs on the SAME machine as your services (the
# usual case) and you use the provided docker-compose.yml, it runs with host
# networking — so use http://127.0.0.1:<port>. That keeps traffic on the box
# and avoids the host firewall entirely.
#
# Only use LAN addresses (http://192.168.x.x:port) when the dashboard runs on a
# DIFFERENT machine than the services. In that case the firewall on the
# services box has to allow this machine.
#
# These are read server-side only — no key is ever sent to the browser.
#
# After editing, restart the dev server, then open /setup to test.
# ---------------------------------------------------------------------------

# Plex Media Server — default port 32400
# Token: open any library item → ⋮ → Get Info → View XML, copy X-Plex-Token
# from the address bar.
PLEX_URL=http://127.0.0.1:32400
PLEX_TOKEN=

# Tautulli — default port 8181
# Key: Settings → Web Interface → API key
TAUTULLI_URL=http://127.0.0.1:8181
TAUTULLI_API_KEY=

# Sonarr — default port 8989
# Key: Settings → General → API Key
SONARR_URL=http://127.0.0.1:8989
SONARR_API_KEY=

# Radarr — default port 7878
# Key: Settings → General → API Key
RADARR_URL=http://127.0.0.1:7878
RADARR_API_KEY=

# Bazarr — default port 6767
# Key: Settings → General → API Key
BAZARR_URL=http://127.0.0.1:6767
BAZARR_API_KEY=

# Glances — default port 61208. No API key.
# Run it on the server with the compose service in docker-compose.yml.
GLANCES_URL=http://127.0.0.1:61208
# Glances 4 is current; set to 3 for older installs. The client probes both,
# so this is only a hint.
GLANCES_API_VERSION=4

# Filename for the library-size history (JSON Lines), stored in ./data/.
# Delete the file to reset the growth chart.
HISTORY_FILE=history.jsonl
